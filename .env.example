# ID des öffentlichen Google Sheets (aus der Sheet-URL:
# https://docs.google.com/spreadsheets/d/<DIESE-ID>/edit)
# Sheet muss auf "Jeder mit dem Link kann es ansehen" freigegeben sein.
GOOGLE_SHEET_ID=

# Optional: Domain für Cloudflare Web Analytics (kostenlos, datenschutzfreundlich,
# kein Cookie-Banner nötig). Leer lassen, um Analytics komplett zu deaktivieren.
PUBLIC_PLAUSIBLE_DOMAIN=
