---
import '../styles/global.css';
import { ALL_CATEGORIES, CATEGORY_LABELS } from '../lib/categoryLabels';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  /** Set false only for pages intentionally excluded from search results (e.g. thin
   * utility pages) — see MIN_PROVIDERS_PER_COMBO in buildData.ts for why some
   * programmatic pages simply aren't generated at all rather than noindexed. */
  index?: boolean;
}

const { title, description, canonicalPath, ogImage, index = true } = Astro.props;
const siteUrl = Astro.site!.origin;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const resolvedOgImage = ogImage ?? `${siteUrl}/og-default.png`;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const previewMode = import.meta.env.PUBLIC_PREVIEW_MODE === 'true';
const shouldIndex = index && !previewMode;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Fiskalis',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description:
    'Fiskalis ist ein unabhängiges Verzeichnis, das Steuerberater, Finanzberater und Buchhalter in Deutschland mit Mandanten zusammenbringt, die bereits gezielt danach suchen.',
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#a9702c" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    {!shouldIndex && <meta name="robots" content="noindex,follow" />}

    <title>{title} | Fiskalis</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fiskalis" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />

    {
      plausibleDomain && (
        <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js" />
      )
    }
    <slot name="head" />
  </head>
  <body>
    {
      previewMode && (
        <p class="preview-banner">
          Vorschau-Version — Fiskalis ist noch nicht öffentlich live. Die gezeigten Profile sind
          Beispiel-/Demo-Einträge.
        </p>
      )
    }
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__logo" href="/">
          <span class="mark">F</span> Fiskalis
        </a>
        <nav class="site-header__nav" id="site-nav">
          {
            ALL_CATEGORIES.map((kat) => (
              <a href={`/${kat}/`}>{CATEGORY_LABELS[kat].plural}</a>
            ))
          }
          <a href="/fuer-anbieter/">Für Anbieter</a>
        </nav>
        <a class="btn btn-primary site-header__cta" href="/quiz/" aria-label="In 2 Min. passenden Berater finden">
          <span class="site-header__cta-full" aria-hidden="true">In 2 Min. passenden Berater finden</span>
          <span class="site-header__cta-short" aria-hidden="true">Quiz starten</span>
        </a>
        <button
          type="button"
          class="site-header__menu-toggle"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Menü öffnen"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <script is:inline>
      const menuToggle = document.querySelector('.site-header__menu-toggle');
      const siteHeader = document.querySelector('.site-header');
      menuToggle?.addEventListener('click', () => {
        const isOpen = siteHeader?.classList.toggle('is-nav-open');
        menuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        menuToggle.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen');
      });
    </script>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__col">
          <a class="site-footer__logo" href="/">Fiskalis</a>
        </div>
        <div class="site-footer__col">
          <h4>Berater finden</h4>
          {
            ALL_CATEGORIES.map((kat) => (
              <a href={`/${kat}/`}>{CATEGORY_LABELS[kat].plural}</a>
            ))
          }
          <a href="/quiz/">Matching-Quiz</a>
        </div>
        <div class="site-footer__col">
          <h4>Für Anbieter</h4>
          <a href="/fuer-anbieter/">Jetzt listen</a>
        </div>
        <div class="site-footer__col">
          <h4>Rechtliches</h4>
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
          <a href="/nutzungsbedingungen/">Nutzungsbedingungen</a>
          <a href="/anbieter-agb/">Anbieter-AGB</a>
          <a href="/inhalt-melden/">Inhalt melden</a>
        </div>
      </div>
      <p class="site-footer__copy">&copy; {new Date().getFullYear()} Fiskalis. Fiskalis ist ein unabhängiges Verzeichnis und erbringt selbst keine Steuer-, Finanz- oder Rechtsberatung.</p>
    </footer>
  </body>
</html>
