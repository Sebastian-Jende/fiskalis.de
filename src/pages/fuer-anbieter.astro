---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFaqEntriesForPage, getListedProviders } from '../lib/buildData';

const faq = await getFaqEntriesForPage('fuer-anbieter');
const providerCount = (await getListedProviders()).length;
---

<BaseLayout
  title="Für Anbieter"
  description="Listen Sie Ihre Steuerberatung, Finanzberatung oder Buchhaltung auf Fiskalis und werden Sie von Mandanten gefunden, die bereits gezielt suchen — keine Vermittlungsprovision."
  canonicalPath="/fuer-anbieter/"
>
  <section class="pro-hero">
    <div class="wrap">
      <p class="eyebrow">Für Anbieter</p>
      <h1>Werden Sie gefunden von Mandanten, die bereits suchen.</h1>
      <p class="pro-hero__lede">
        Fiskalis ist das Verzeichnis für Steuerberater, Finanzberater und Buchhalter in
        Deutschland. Ein Jahres-Listing, keine Vermittlungsprovision — Sie behalten jeden Euro,
        den Ihre Mandanten Ihnen zahlen.
      </p>
      <a class="btn btn-primary" href="#bewerbung">Jetzt Kontakt aufnehmen</a>
      <p class="pro-hero__stat">{providerCount} Anbieter bereits gelistet</p>
    </div>
  </section>

  <section class="wrap included">
    <h2>Was ein Listing beinhaltet</h2>
    <ul class="included__list">
      <li>Eigenes Profil mit Leistungen, Spezialisierungen und Branchen</li>
      <li>Direkte Kontaktdaten (Telefon, E-Mail, Website) — keine Zwischenschaltung</li>
      <li>Sichtbarkeit in Kategorie-, Stadt- und Spezialisierungs-Seiten</li>
      <li>Anzeige echter Mandanten-Bewertungen auf Ihrem Profil</li>
    </ul>
    <p class="included__note">
      Keine Vermittlungsprovision, niemals. Was Ihre Mandanten Ihnen zahlen, bleibt zu 100 % bei
      Ihnen. Die Konditionen für ein Listing besprechen wir persönlich — schreiben Sie uns
      einfach, Details in den <a href="/anbieter-agb/">Vertragsbedingungen</a>.
    </p>
  </section>

  <section class="wrap process">
    <h2>So funktioniert die Aufnahme</h2>
    <ol class="process__list">
      <li><strong>Kontakt aufnehmen.</strong> Kurze E-Mail mit den wichtigsten Eckdaten — siehe unten.</li>
      <li><strong>Kurzes Kennenlerngespräch.</strong> Wir klären Konditionen und ob Fiskalis für Sie passt.</li>
      <li><strong>Freischaltung.</strong> Ihr Profil geht direkt nach Einigung live.</li>
    </ol>
  </section>

  {
    faq.length > 0 && (
      <section class="wrap pro-faq">
        <h2>Häufige Fragen</h2>
        {faq.map((entry) => (
          <details>
            <summary>{entry.frage}</summary>
            <p set:html={entry.antwort} />
          </details>
        ))}
      </section>
    )
  }

  <section class="wrap application" id="bewerbung">
    <h2>Jetzt bewerben</h2>
    <p class="application__lede">
      Schreiben Sie uns kurz per E-Mail — Kanzlei-/Firmenname, Kategorie, Ort und ein bis zwei
      Sätze zu Ihrer Praxis reichen für den Anfang.
    </p>
    <a
      class="btn btn-accent"
      href={`mailto:info@sebastianjende.com?subject=${encodeURIComponent('Bewerbung für Fiskalis-Listing')}&body=${encodeURIComponent('Kanzlei-/Firmenname: \nAnsprechpartner:in: \nKategorie (Steuerberater/Finanzberater/Buchhalter): \nOrt: \nWebsite: \n\nKurz zu Ihrer Kanzlei/Praxis:\n')}`}
    >
      Bewerbung per E-Mail senden
    </a>
  </section>
</BaseLayout>

<style>
  .pro-hero {
    background: var(--color-bg-sunken);
    border-bottom: 1px solid var(--color-line);
    padding: 3.5rem 0;
  }
  .pro-hero h1 {
    max-width: 18ch;
  }
  .pro-hero__lede {
    max-width: 58ch;
    color: var(--color-ink-soft);
    font-size: 1.05rem;
  }
  .pro-hero__stat {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-ink-faint);
  }

  .included {
    padding: 3.5rem 0 2rem;
  }
  .included__list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.8rem 1.5rem;
    max-width: 780px;
  }
  .included__list li {
    font-size: 0.96rem;
    color: var(--color-ink-soft);
  }
  .included__list li::before {
    content: '✓ ';
    color: var(--color-teal);
    font-weight: 700;
  }
  .included__note {
    margin-top: 1.8rem;
    color: var(--color-ink-faint);
    font-size: 0.88rem;
    max-width: 60ch;
  }

  .process {
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-line);
  }
  .process__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-left: 1.3rem;
  }
  .process__list li {
    color: var(--color-ink-soft);
  }

  .pro-faq {
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-line);
  }
  .pro-faq details {
    border-bottom: 1px solid var(--color-line);
    padding: 0.9rem 0;
  }
  .pro-faq summary {
    cursor: pointer;
    font-weight: 600;
  }
  .pro-faq p {
    color: var(--color-ink-soft);
    margin: 0.6rem 0 0;
  }

  .application {
    padding: 3rem 0 5rem;
    border-top: 1px solid var(--color-line);
  }
  .application__lede {
    max-width: 56ch;
    color: var(--color-ink-soft);
    margin: 0.8rem 0 1.5rem;
  }
</style>
