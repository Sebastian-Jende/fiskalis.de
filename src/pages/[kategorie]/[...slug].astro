---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import StarRating from '../../components/StarRating.astro';
import BewertungsHinweis from '../../components/BewertungsHinweis.astro';
import BreadcrumbSchema from '../../components/JsonLd/BreadcrumbSchema.astro';
import CollectionPageSchema from '../../components/JsonLd/CollectionPageSchema.astro';
import ProviderSchema from '../../components/JsonLd/ProviderSchema.astro';
import {
  assertSlugNamespaceIsUnique,
  getCityCombosForCategory,
  getSpecializationCombosForCategory,
  getProvidersByCategory,
  getRatingSummary,
  primaryKategorie,
} from '../../lib/buildData';
import { ALL_CATEGORIES, CATEGORY_LABELS } from '../../lib/categoryLabels';
import type { Kategorie, Provider } from '../../lib/types';

// This one route renders three different page "kinds" that share one namespace under
// /{kategorie}/ — a city listing, a specialization listing, or a provider's own
// profile — exactly like Uhrenverzeichnis.de's /haendler/[...slug].astro. A shared
// namespace (instead of three separate dynamic segments) is what lets a single slug
// disambiguate without Astro route-priority ambiguity; assertSlugNamespaceIsUnique
// guards that no two of them ever collide within a category.
type PageProps =
  | { kind: 'stadt'; kategorie: Kategorie; citySlug: string }
  | { kind: 'spezialisierung'; kategorie: Kategorie; specSlug: string }
  | { kind: 'anbieter'; kategorie: Kategorie; provider: Provider };

export async function getStaticPaths() {
  await Promise.all(ALL_CATEGORIES.map(assertSlugNamespaceIsUnique));

  const paths: { params: { kategorie: Kategorie; slug: string }; props: PageProps }[] = [];

  for (const kategorie of ALL_CATEGORIES) {
    const [cityCombos, specCombos, providers] = await Promise.all([
      getCityCombosForCategory(kategorie),
      getSpecializationCombosForCategory(kategorie),
      getProvidersByCategory(kategorie),
    ]);

    for (const combo of cityCombos) {
      paths.push({
        params: { kategorie, slug: combo.city.slug },
        props: { kind: 'stadt', kategorie, citySlug: combo.city.slug },
      });
    }
    for (const combo of specCombos) {
      paths.push({
        params: { kategorie, slug: combo.specialization.slug },
        props: { kind: 'spezialisierung', kategorie, specSlug: combo.specialization.slug },
      });
    }
    for (const provider of providers) {
      if (primaryKategorie(provider) !== kategorie) continue;
      paths.push({
        params: { kategorie, slug: provider.slug },
        props: { kind: 'anbieter', kategorie, provider },
      });
    }
  }

  return paths;
}

const props = Astro.props as PageProps;
const { kategorie } = props;
const label = CATEGORY_LABELS[kategorie];
const siteUrl = 'https://fiskalis.de';
const categoryUrl = `${siteUrl}/${kategorie}/`;

// ---- "stadt" / "spezialisierung": near-identical listing pages ----
let listingHeading = '';
let listingIntro = '';
let listingMetaDescription = '';
let listingProviders: Provider[] = [];
let listingCanonical = '';
let exploreLinks: { label: string; href: string }[] = [];

if (props.kind === 'stadt') {
  const combos = await getCityCombosForCategory(kategorie);
  const combo = combos.find((c) => c.city.slug === props.citySlug)!;
  listingHeading = `${label.plural} in ${combo.city.name}`;
  listingCanonical = `/${kategorie}/${combo.city.slug}/`;
  listingProviders = combo.providers;
  listingIntro =
    combo.city.intro_text ??
    `${combo.providers.length} ${label.plural} in ${combo.city.name}${combo.city.bundesland ? ` (${combo.city.bundesland})` : ''} im Vergleich — mit echten Mandanten-Bewertungen und Spezialisierungen auf einen Blick.`;
  listingMetaDescription =
    combo.city.meta_beschreibung ??
    `${label.plural} in ${combo.city.name} finden: ${combo.providers.length} Profile mit Bewertungen vergleichen.`;
  const specCombos = await getSpecializationCombosForCategory(kategorie);
  exploreLinks = specCombos.map((s) => ({
    label: `${label.plural} für ${s.specialization.name} →`,
    href: `/${kategorie}/${s.specialization.slug}/`,
  }));
} else if (props.kind === 'spezialisierung') {
  const combos = await getSpecializationCombosForCategory(kategorie);
  const combo = combos.find((c) => c.specialization.slug === props.specSlug)!;
  listingHeading = `${label.plural} für ${combo.specialization.name}`;
  listingCanonical = `/${kategorie}/${combo.specialization.slug}/`;
  listingProviders = combo.providers;
  listingIntro =
    combo.specialization.intro_text ??
    `${combo.providers.length} ${label.plural} mit Spezialisierung auf ${combo.specialization.name} — mit echten Mandanten-Bewertungen im Vergleich.`;
  listingMetaDescription =
    combo.specialization.meta_beschreibung ??
    `${label.plural} für ${combo.specialization.name}: ${combo.providers.length} Profile mit Bewertungen vergleichen.`;
  const cityCombos = await getCityCombosForCategory(kategorie);
  exploreLinks = cityCombos.map((c) => ({
    label: `${label.plural} in ${c.city.name} →`,
    href: `/${kategorie}/${c.city.slug}/`,
  }));
}

// ---- "anbieter": full profile page ----
let provider: Provider | null = null;
let rating = { count: 0, average: null as number | null, averageKommunikation: null as number | null, averageFachwissen: null as number | null, averageZufriedenheit: null as number | null };
let relatedProviders: Provider[] = [];

if (props.kind === 'anbieter') {
  provider = props.provider;
  rating = getRatingSummary(provider);
  const categoryProviders = await getProvidersByCategory(kategorie);
  relatedProviders = categoryProviders
    .filter((p) => p.slug !== provider!.slug)
    .filter((p) => p.ort?.slug === provider!.ort?.slug || p.spezialisierungen.some((s) => provider!.spezialisierungen.some((ps) => ps.slug === s.slug)))
    .slice(0, 3);
}
---

{
  props.kind !== 'anbieter' && (
    <BaseLayout title={listingHeading} description={listingMetaDescription} canonicalPath={listingCanonical}>
      <BreadcrumbSchema
        items={[
          { name: 'Fiskalis', url: siteUrl },
          { name: label.plural, url: categoryUrl },
          { name: listingHeading, url: `${siteUrl}${listingCanonical}` },
        ]}
      />
      <CollectionPageSchema
        name={listingHeading}
        description={listingMetaDescription}
        url={`${siteUrl}${listingCanonical}`}
        items={listingProviders.map((p) => ({ name: p.name, url: `${siteUrl}/${primaryKategorie(p)}/${p.slug}/` }))}
      />

      <section class="wrap combo-hero">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Fiskalis</a> / <a href={`/${kategorie}/`}>{label.plural}</a> / <span>{listingHeading}</span>
        </nav>
        <h1>{listingHeading}</h1>
        <p class="combo-hero__intro">{listingIntro}</p>
      </section>

      <section class="wrap combo-list">
        {
          listingProviders.length === 0 ? (
            <p>Für diese Auswahl sind aktuell keine Profile gelistet.</p>
          ) : (
            listingProviders.map((p) => <ProviderCard provider={p} />)
          )
        }
      </section>

      {
        exploreLinks.length > 0 && (
          <section class="wrap combo-explore">
            <h2>Mehr entdecken</h2>
            <div class="combo-explore__grid">
              {exploreLinks.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </section>
        )
      }
    </BaseLayout>
  )
}

{
  props.kind === 'anbieter' && provider && (
    <BaseLayout
      title={`${provider.name} — ${label.singular}`}
      description={provider.tagline ?? `${provider.name}: ${label.singular} ${provider.ort ? `in ${provider.ort.name}` : ''}. Profil, Leistungen und echte Bewertungen auf Fiskalis.`}
      canonicalPath={`/${kategorie}/${provider.slug}/`}
    >
      <BreadcrumbSchema
        items={[
          { name: 'Fiskalis', url: siteUrl },
          { name: label.plural, url: categoryUrl },
          { name: provider.name, url: `${siteUrl}/${kategorie}/${provider.slug}/` },
        ]}
      />
      <ProviderSchema provider={provider} kategorie={kategorie} url={`${siteUrl}/${kategorie}/${provider.slug}/`} />

      <section class="profile-hero">
        <div class="wrap">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Fiskalis</a> / <a href={`/${kategorie}/`}>{label.plural}</a> / <span>{provider.name}</span>
          </nav>
          <div class="profile-hero__badges">
            {provider.kategorien.map((k) => <span class="badge-pill">{CATEGORY_LABELS[k].singular}</span>)}
          </div>
          <h1>{provider.name}</h1>
          {provider.tagline && <p class="profile-hero__tagline">{provider.tagline}</p>}
          <StarRating average={rating.average} count={rating.count} />
        </div>
      </section>

      <section class="wrap profile-body">
        <div class="profile-main">
          <dl class="profile-facts">
            <div>
              <dt>Sitz</dt>
              <dd>{provider.ort ? provider.ort.name : 'Bundesweit'}{provider.bundesweit_remote && ' · bundesweit remote'}</dd>
            </div>
            {provider.gegruendet && (
              <div>
                <dt>Gegründet</dt>
                <dd>{provider.gegruendet} · {new Date().getFullYear() - provider.gegruendet} Jahre tätig</dd>
              </div>
            )}
            {provider.team_groesse && (
              <div>
                <dt>Teamgröße</dt>
                <dd>{provider.team_groesse} {provider.team_groesse === 1 ? 'Person' : 'Personen'}</dd>
              </div>
            )}
            {provider.kammer_id && (
              <div>
                <dt>Zulassung/Register-Nr.</dt>
                <dd>{provider.kammer_id}</dd>
              </div>
            )}
          </dl>

          {provider.min_mandatsgroesse && (
            <div class="profile-callout">
              <p class="profile-callout__label">Mindestanforderung</p>
              <p>{provider.min_mandatsgroesse}</p>
            </div>
          )}

          {provider.ueber_uns && (
            <div class="profile-section">
              <h2>Über {provider.name}</h2>
              <p>{provider.ueber_uns}</p>
            </div>
          )}

          {provider.leistungen.length > 0 && (
            <div class="profile-section">
              <h2>Leistungen</h2>
              <div class="tag-grid">{provider.leistungen.map((l) => <span class="tag">{l}</span>)}</div>
            </div>
          )}

          {provider.spezialisierungen.length > 0 && (
            <div class="profile-section">
              <h2>Spezialisierungen</h2>
              <div class="tag-grid">{provider.spezialisierungen.map((s) => <span class="tag">{s.name}</span>)}</div>
            </div>
          )}

          {provider.branchen.length > 0 && (
            <div class="profile-section">
              <h2>Branchen</h2>
              <div class="tag-grid">{provider.branchen.map((b) => <span class="tag">{b}</span>)}</div>
            </div>
          )}

          {provider.preismodell && (
            <div class="profile-section">
              <h2>Preismodell</h2>
              <p>{provider.preismodell}</p>
            </div>
          )}

          <div class="profile-section" id="bewertungen">
            <h2>Bewertungen ({rating.count})</h2>
            {rating.count > 0 && (
              <dl class="rating-breakdown">
                <div><dt>Kommunikation</dt><dd>{rating.averageKommunikation ?? '–'}</dd></div>
                <div><dt>Fachwissen</dt><dd>{rating.averageFachwissen ?? '–'}</dd></div>
                <div><dt>Zufriedenheit</dt><dd>{rating.averageZufriedenheit ?? '–'}</dd></div>
              </dl>
            )}
            <BewertungsHinweis />

            {provider.reviews.filter((r) => r.freigegeben).length === 0 ? (
              <p class="profile-no-reviews">Noch keine Bewertungen — seien Sie die erste Person, die {provider.name} bewertet.</p>
            ) : (
              <ul class="review-list">
                {provider.reviews.filter((r) => r.freigegeben).map((r) => (
                  <li>
                    <div class="review-list__head">
                      <strong>{r.name}</strong>
                      {r.datum && <span class="review-list__date">{r.datum}</span>}
                    </div>
                    <p>{r.text}</p>
                  </li>
                ))}
              </ul>
            )}
            <a class="btn btn-secondary" href={`mailto:info@sebastianjende.com?subject=${encodeURIComponent(`Bewertung für ${provider.name}`)}`}>
              Bewertung per E-Mail einreichen
            </a>
          </div>
        </div>

        <aside class="profile-sidebar">
          <div class="card contact-box" id="kontakt">
            <h3>Kontakt zu {provider.name}</h3>
            <dl class="contact-box__list">
              {provider.telefon && (
                <div>
                  <dt>Telefon</dt>
                  <dd><a href={`tel:${provider.telefon.replace(/\s+/g, '')}`}>{provider.telefon}</a></dd>
                </div>
              )}
              {provider.email && (
                <div>
                  <dt>E-Mail</dt>
                  <dd><a href={`mailto:${provider.email}`}>{provider.email}</a></dd>
                </div>
              )}
            </dl>
            {provider.website_url && (
              <a class="btn btn-primary contact-box__website" href={provider.website_url} target="_blank" rel="noopener nofollow">
                Website besuchen ↗
              </a>
            )}
            {!provider.telefon && !provider.email && !provider.website_url && (
              <p class="contact-box__empty">Für diesen Anbieter sind noch keine Kontaktdaten hinterlegt.</p>
            )}
          </div>
        </aside>
      </section>

      {relatedProviders.length > 0 && (
        <section class="wrap combo-explore">
          <h2>Mehr entdecken</h2>
          <div class="combo-explore__grid combo-explore__grid--cards">
            {relatedProviders.map((p) => <ProviderCard provider={p} />)}
          </div>
        </section>
      )}
    </BaseLayout>
  )
}

<style>
  .breadcrumb {
    font-size: 0.8rem;
    color: var(--color-ink-faint);
    margin-bottom: 1.2rem;
  }
  .breadcrumb a {
    color: var(--color-ink-faint);
    text-decoration: none;
  }
  .breadcrumb span {
    color: var(--color-ink-soft);
  }

  .combo-hero {
    padding: 2.5rem 0 1.5rem;
  }
  .combo-hero__intro {
    max-width: 62ch;
    color: var(--color-ink-soft);
    font-size: 1.02rem;
  }
  .combo-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.1rem;
    padding-bottom: 2rem;
  }
  .combo-explore {
    padding: 2.5rem 0 3.5rem;
    border-top: 1px solid var(--color-line);
  }
  .combo-explore__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.6rem 1.5rem;
  }
  .combo-explore__grid--cards {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.1rem;
  }
  .combo-explore__grid a {
    text-decoration: none;
    color: var(--color-teal);
    font-size: 0.92rem;
  }

  .profile-hero {
    background: var(--color-bg-sunken);
    border-bottom: 1px solid var(--color-line);
    padding: 2.5rem 0;
  }
  .profile-hero__badges {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
    flex-wrap: wrap;
  }
  .profile-hero__tagline {
    font-size: 1.05rem;
    color: var(--color-ink-soft);
    max-width: 60ch;
    margin-bottom: 0.9rem;
  }

  .profile-body {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    padding: 2.5rem 0 4rem;
    align-items: start;
  }
  .profile-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1.2rem;
    padding: 1.2rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 1.8rem;
  }
  .profile-facts dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-faint);
    margin-bottom: 0.2rem;
  }
  .profile-facts dd {
    margin: 0;
    font-weight: 600;
  }
  .profile-callout {
    background: var(--color-accent-soft);
    border-radius: 8px;
    padding: 1rem 1.2rem;
    margin-bottom: 1.8rem;
  }
  .profile-callout__label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-dark);
    font-weight: 700;
    margin: 0 0 0.3rem;
  }
  .profile-callout p:last-child {
    margin: 0;
  }
  .profile-section {
    margin-bottom: 2.2rem;
  }
  .profile-section h2 {
    font-size: 1.15rem;
  }
  .profile-section p {
    color: var(--color-ink-soft);
  }
  .tag-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--color-bg-sunken);
    border: 1px solid var(--color-line);
  }

  .rating-breakdown {
    display: flex;
    gap: 2rem;
    margin: 1rem 0;
  }
  .rating-breakdown dt {
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }
  .rating-breakdown dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .profile-no-reviews {
    color: var(--color-ink-faint);
    font-style: italic;
  }
  .review-list {
    list-style: none;
    margin: 1rem 0;
    padding: 0;
  }
  .review-list li {
    padding: 1rem 0;
    border-top: 1px solid var(--color-line);
  }
  .review-list__head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .review-list__date {
    color: var(--color-ink-faint);
    font-size: 0.8rem;
  }
  .review-list p {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .profile-sidebar {
    position: sticky;
    top: 90px;
  }
  .contact-box {
    padding: 1.5rem;
  }
  .contact-box h3 {
    margin-bottom: 1rem;
  }
  .contact-box__list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 0 0 1.2rem;
  }
  .contact-box__list dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-faint);
    margin-bottom: 0.2rem;
  }
  .contact-box__list dd {
    margin: 0;
    font-weight: 600;
  }
  .contact-box__list a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .contact-box__list a:hover {
    color: var(--color-teal);
  }
  .contact-box__website {
    display: block;
    width: 100%;
    text-align: center;
  }
  .contact-box__empty {
    color: var(--color-ink-faint);
    font-size: 0.88rem;
    font-style: italic;
    margin: 0;
  }

  @media (max-width: 900px) {
    .profile-body {
      grid-template-columns: 1fr;
    }
    .profile-sidebar {
      position: static;
    }
  }
</style>
