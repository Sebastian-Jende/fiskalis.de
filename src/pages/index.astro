---
import BaseLayout from '../layouts/BaseLayout.astro';
import WebSiteSchema from '../components/JsonLd/WebSiteSchema.astro';
import { ALL_CATEGORIES, CATEGORY_LABELS } from '../lib/categoryLabels';
import {
  getProvidersByCategory,
  getFaqEntriesForPage,
  getListedProviders,
  getRatingSummary,
  primaryKategorie,
  ratingOf,
} from '../lib/buildData';

const counts = await Promise.all(
  ALL_CATEGORIES.map(async (k) => ({ kategorie: k, count: (await getProvidersByCategory(k)).length }))
);
const faq = await getFaqEntriesForPage('home');

const providers = await getListedProviders();

// Hero-Karussel: eine einzelne Karte im Hero, die automatisch durch echte gelistete Anbieter
// rotiert (Vorbild: samslist.com) — kein Lorem-Ipsum-Platzhalter, sondern reale Sheet-Daten.
// Kein "Verified"-Badge wie bei Sam's List, siehe Positionierung: Fiskalis listet, prüft nicht.
const heroMatches = providers.slice(0, 8).map((p) => {
  const rating = getRatingSummary(p);
  return {
    name: p.name,
    sub: p.tagline ?? CATEGORY_LABELS[primaryKategorie(p)].singular,
    kategorie: CATEGORY_LABELS[primaryKategorie(p)].singular,
    ort: p.ort?.name ?? 'Bundesweit',
    remote: p.bundesweit_remote,
    ratingAvg: rating.average,
    ratingCount: rating.count,
    tags: p.spezialisierungen.slice(0, 3).map((s) => s.name),
    anforderung: p.min_mandatsgroesse,
    href: `/${primaryKategorie(p)}/${p.slug}/`,
  };
});

// Testimonials: ausschließlich echte, bereits freigegebene Bewertungen aus dem Sheet —
// keine erfundenen Zitate.
const testimonials = providers
  .flatMap((p) =>
    p.reviews
      .filter((r) => r.freigegeben && r.text.length > 30)
      .map((r) => ({ ...r, rating: ratingOf(r), providerName: p.name }))
  )
  .sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0) || b.text.length - a.text.length)
  .slice(0, 4);
---

<BaseLayout
  title="Steuerberater, Finanzberater & Buchhalter finden"
  description="Fiskalis ist das unabhängige Verzeichnis für Steuerberater, Finanzberater und Buchhalter in Deutschland — mit echten Mandanten-Bewertungen."
  canonicalPath="/"
>
  <WebSiteSchema name="Fiskalis" url={Astro.site!.origin} />

  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Fiskalis · Verzeichnis &amp; Marktplatz</p>
        <h1>Finden Sie Ihren nächsten Finanzpartner.</h1>
        <p class="hero__lede">
          Das Verzeichnis, in dem Steuerberater, Finanzberater und Buchhalter bereits nach neuen
          Mandanten suchen — mit echten Bewertungen von Mandanten, die schon dort waren, wo Sie
          gerade stehen.
        </p>

        <div class="hero__selector">
          <p class="hero__selector-label">Ich suche…</p>
          <div class="hero__selector-options">
            {
              ALL_CATEGORIES.map((k) => (
                <a class="hero__selector-option" href={`/${k}/`}>{CATEGORY_LABELS[k].akkusativ}</a>
              ))
            }
          </div>
          <p class="hero__selector-hint">Wählen Sie eine Option, um zu starten →</p>
        </div>

        <a class="hero__quiz-banner" href="/quiz/">
          <span class="hero__quiz-btn-wrap">
            <span class="hero__quiz-btn">✨ 2-Minuten-Quiz starten</span>
            <span class="hero__quiz-badge">NEU</span>
          </span>
          <span class="hero__quiz-text">
            Erzählen Sie uns von Ihrem Bedarf — wir zeigen Ihnen passende Berater.
          </span>
        </a>
      </div>

      {
        heroMatches.length > 0 && (
          <div class="hero__match-wrap">
            <a class="card hero__match" id="hero-match" href={heroMatches[0].href} aria-live="polite">
              <div class="hero__match-head">
                <span class="hero__match-avatar" aria-hidden="true">{heroMatches[0].name.charAt(0)}</span>
                <div>
                  <p class="hero__match-name">{heroMatches[0].name}</p>
                  <p class="hero__match-sub">{heroMatches[0].sub}</p>
                </div>
              </div>
              <span class="badge-pill hero__match-kategorie">{heroMatches[0].kategorie}</span>
              {heroMatches[0].ratingAvg ? (
                <p class="hero__match-rating">
                  <span class="hero__match-stars">★★★★★</span> {heroMatches[0].ratingAvg.toFixed(1)}
                  <span class="hero__match-count"> · {heroMatches[0].ratingCount} Bewertungen</span>
                </p>
              ) : (
                <p class="hero__match-rating hero__match-rating--empty">Noch keine Bewertungen</p>
              )}
              <p class="hero__match-location">
                {heroMatches[0].ort}
                {heroMatches[0].remote && ' · Remote möglich'}
              </p>
              {heroMatches[0].tags.length > 0 && (
                <div class="hero__match-tags">
                  {heroMatches[0].tags.map((t: string) => <span class="tag">{t}</span>)}
                </div>
              )}
              {heroMatches[0].anforderung && (
                <div class="hero__match-req">
                  <p class="hero__match-req-label">Mindestanforderung</p>
                  <p>{heroMatches[0].anforderung}</p>
                </div>
              )}
              <span class="btn btn-secondary hero__match-cta">Profil ansehen →</span>
            </a>
          </div>
        )
      }
    </div>
  </section>

  <script type="application/json" id="hero-matches" is:inline set:html={JSON.stringify(heroMatches)} />

  <script is:inline>
    (function () {
      const dataEl = document.getElementById('hero-matches');
      const card = document.getElementById('hero-match');
      if (!dataEl || !card) return;
      const matches = JSON.parse(dataEl.textContent);
      if (matches.length < 2) return;

      let index = 0;
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      function render(m) {
        card.href = m.href;
        const ratingHtml = m.ratingAvg
          ? `<p class="hero__match-rating"><span class="hero__match-stars">★★★★★</span> ${m.ratingAvg.toFixed(1)}<span class="hero__match-count"> · ${m.ratingCount} Bewertungen</span></p>`
          : `<p class="hero__match-rating hero__match-rating--empty">Noch keine Bewertungen</p>`;
        const tagsHtml = m.tags.length
          ? `<div class="hero__match-tags">${m.tags.map((t) => `<span class="tag">${escapeHtml(t)}</span>`).join('')}</div>`
          : '';
        const reqHtml = m.anforderung
          ? `<div class="hero__match-req"><p class="hero__match-req-label">Mindestanforderung</p><p>${escapeHtml(m.anforderung)}</p></div>`
          : '';
        card.innerHTML = `
          <div class="hero__match-head">
            <span class="hero__match-avatar" aria-hidden="true">${escapeHtml(m.name.charAt(0))}</span>
            <div>
              <p class="hero__match-name">${escapeHtml(m.name)}</p>
              <p class="hero__match-sub">${escapeHtml(m.sub)}</p>
            </div>
          </div>
          <span class="badge-pill hero__match-kategorie">${escapeHtml(m.kategorie)}</span>
          ${ratingHtml}
          <p class="hero__match-location">${escapeHtml(m.ort)}${m.remote ? ' · Remote möglich' : ''}</p>
          ${tagsHtml}
          ${reqHtml}
          <span class="btn btn-secondary hero__match-cta">Profil ansehen →</span>
        `;
      }

      function next() {
        card.classList.add('is-fading');
        setTimeout(() => {
          index = (index + 1) % matches.length;
          render(matches[index]);
          card.classList.remove('is-fading');
        }, 220);
      }

      if (!prefersReduced) {
        let timer = setInterval(next, 4200);
        card.addEventListener('mouseenter', () => clearInterval(timer));
        card.addEventListener('mouseleave', () => {
          timer = setInterval(next, 4200);
        });
      }
    })();
  </script>

  {
    testimonials.length > 0 && (
      <section class="wrap testimonials">
        <h2>Was Mandanten sagen</h2>
        <div class="testimonials__grid">
          {testimonials.map((t) => (
            <div class="card testimonials__card">
              {t.rating && <span class="testimonials__stars">{'★'.repeat(Math.round(t.rating))}</span>}
              <p class="testimonials__text">„{t.text}"</p>
              <p class="testimonials__attr">
                — {t.name}, über <strong>{t.providerName}</strong>
              </p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap ways">
    <h2>Vier Wege, Fiskalis zu nutzen</h2>
    <div class="ways__grid">
      <div class="ways__item">
        <span class="ways__num">01</span>
        <h3>Nach Ort &amp; Spezialisierung filtern</h3>
        <p>Suchen Sie gezielt nach Standort, Branchenerfahrung und Leistungsumfang — statt nach dem erstbesten Google-Treffer zu greifen.</p>
      </div>
      <div class="ways__item">
        <span class="ways__num">02</span>
        <h3>Echte Bewertungen vor der Anfrage lesen</h3>
        <p>Jede Bewertung stammt von echten Mandanten — gut wie schlecht, bevor Sie eine erste Nachricht schreiben.</p>
      </div>
      <div class="ways__item">
        <span class="ways__num">03</span>
        <h3>Selbst eine Bewertung hinterlassen</h3>
        <p>Bereits mit einem Berater zusammengearbeitet? Schreiben Sie uns Ihre Erfahrung — kostenlos, wir veröffentlichen sie auf dem jeweiligen Profil.</p>
      </div>
      <div class="ways__item">
        <span class="ways__num">04</span>
        <h3>Direkt von suchenden Mandanten gefunden werden</h3>
        <p>Sie sind Steuerberater, Finanzberater oder Buchhalter? <a href="/fuer-anbieter/">Listen Sie sich</a> und werden für genau Ihre Zielgruppe sichtbar.</p>
      </div>
    </div>
  </section>

  <section class="wrap categories">
    <h2>Nach Kategorie durchsuchen</h2>
    <div class="categories__grid">
      {
        counts.map(({ kategorie, count }) => (
          <a class="card categories__card" href={`/${kategorie}/`}>
            <h3>{CATEGORY_LABELS[kategorie].plural}</h3>
            <p>{CATEGORY_LABELS[kategorie].heroClaim}</p>
            <span class="categories__count">{count} gelistet →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap marketplace">
    <div class="card marketplace__card">
      <h2>Sie sind Berater, keine Suchmaschine?</h2>
      <p>
        Fiskalis ist ein Marktplatz, kein Prüfsiegel — wir stellen Sie direkt vor Mandanten, die
        bereits gezielt nach jemandem wie Ihnen suchen. Keine Vermittlungsprovision, kein
        Zwischenhändler.
      </p>
      <a href="/fuer-anbieter/">Mehr für Anbieter →</a>
    </div>
  </section>

  {
    faq.length > 0 && (
      <section class="wrap home-faq">
        <h2>Häufige Fragen</h2>
        {faq.map((entry) => (
          <details>
            <summary>{entry.frage}</summary>
            <p set:html={entry.antwort} />
          </details>
        ))}
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    background: var(--color-bg-sunken);
    border-bottom: 1px solid var(--color-line);
    padding: 4rem 0 3.5rem;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 380px);
    gap: 3rem;
    align-items: start;
  }
  .hero h1 {
    max-width: 18ch;
  }
  .hero__lede {
    font-size: 1.1rem;
    color: var(--color-ink-soft);
    max-width: 58ch;
  }
  .hero__selector {
    margin-top: 2.2rem;
  }
  .hero__selector-label {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    color: var(--color-ink);
  }
  .hero__selector-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .hero__selector-option {
    display: flex;
    align-items: center;
    padding: 0.9rem 1.4rem;
    border-radius: 12px;
    border: 2px solid var(--color-ink);
    background: var(--color-bg-sunken);
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 700;
    font-size: 1.02rem;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .hero__selector-option:hover {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .hero__selector-hint {
    margin: 0.9rem 0 0;
    color: var(--color-ink-faint);
    font-size: 0.9rem;
  }

  .hero__quiz-banner {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1.8rem;
    padding: 0.55rem 1.7rem 0.55rem 0.55rem;
    background: var(--color-ink);
    border-radius: 999px;
    text-decoration: none;
    max-width: 100%;
  }
  .hero__quiz-btn-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .hero__quiz-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--color-bg-raised);
    color: var(--color-ink);
    border-radius: 999px;
    padding: 0.75rem 1.3rem;
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .hero__quiz-badge {
    position: absolute;
    top: -0.55rem;
    right: -0.4rem;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
  }
  .hero__quiz-text {
    color: rgba(243, 245, 239, 0.92);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  /* ---- Hero-Match-Karte (Wrapper; Inhalt wird per JS ausgetauscht, siehe globaler Block unten) ---- */
  .hero__match-wrap {
    position: relative;
  }
  .hero__match {
    display: block;
    padding: 1.5rem 1.6rem;
    text-decoration: none;
    color: inherit;
    transition:
      opacity 0.22s ease,
      transform 0.15s ease;
  }
  .hero__match:hover {
    transform: translateY(-2px);
  }
  .hero__match.is-fading {
    opacity: 0;
  }

  /* ---- Testimonials ---- */
  .testimonials {
    padding: 3.5rem 0;
  }
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.2rem;
    margin-top: 2rem;
  }
  .testimonials__card {
    padding: 1.4rem 1.6rem;
  }
  .testimonials__stars {
    color: var(--color-accent);
    letter-spacing: 1px;
  }
  .testimonials__text {
    margin: 0.6rem 0 1rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.5;
  }
  .testimonials__attr {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-ink-faint);
  }
  .testimonials__attr strong {
    color: var(--color-ink-soft);
  }

  .ways,
  .categories,
  .marketplace,
  .home-faq {
    padding: 3.5rem 0;
  }
  .ways {
    border-top: 1px solid var(--color-line);
  }
  .ways__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }
  .ways__num {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--color-accent);
    font-weight: 600;
  }
  .ways__item h3 {
    font-size: 1.05rem;
    margin: 0.4rem 0 0.5rem;
  }
  .ways__item p {
    color: var(--color-ink-soft);
    font-size: 0.94rem;
  }
  .ways__item a {
    color: var(--color-teal);
  }

  .categories {
    border-top: 1px solid var(--color-line);
  }
  .categories__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.2rem;
    margin-top: 2rem;
  }
  .categories__card {
    display: block;
    padding: 1.6rem;
    text-decoration: none;
    color: inherit;
  }
  .categories__card p {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
  }
  .categories__count {
    color: var(--color-teal);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .marketplace {
    border-top: 1px solid var(--color-line);
  }
  .marketplace__card {
    padding: 2rem 2.2rem;
    background: var(--color-teal-soft);
    border-color: var(--color-teal);
  }
  .marketplace__card p {
    color: var(--color-ink-soft);
    max-width: 68ch;
  }
  .marketplace__card a {
    color: var(--color-teal);
    font-weight: 600;
    text-decoration: none;
  }

  .home-faq {
    border-top: 1px solid var(--color-line);
  }
  .home-faq details {
    border-bottom: 1px solid var(--color-line);
    padding: 0.9rem 0;
  }
  .home-faq summary {
    cursor: pointer;
    font-weight: 600;
  }
  .home-faq p {
    color: var(--color-ink-soft);
    margin: 0.6rem 0 0;
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__match-wrap {
      max-width: 380px;
    }
  }

  @media (max-width: 560px) {
    /* A tall stack inside a fully round pill turns into an egg shape — switch to a
       rounded rectangle with the button above the text instead. */
    .hero__quiz-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.9rem;
      border-radius: 20px;
      padding: 1.2rem 1.3rem;
    }
    .hero__quiz-badge {
      top: -0.6rem;
      right: -0.5rem;
    }
    .hero__quiz-btn {
      white-space: normal;
    }
  }
</style>

<style is:global>
  /* Hero-Match-Karte: Inhalt wird sowohl beim ersten Server-Render als auch bei jedem
     automatischen Kartenwechsel per JS (innerHTML) erzeugt — deshalb global statt gescoped,
     sonst verlieren die JS-erzeugten Elemente nach dem ersten Wechsel ihr Styling
     (Astros Scoped-CSS-Attribut wird nur beim Build in den Server-Markup geschrieben). */
  .hero__match-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.9rem;
  }
  .hero__match-avatar {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-teal-soft);
    color: var(--color-teal);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero__match-name {
    margin: 0;
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-ink);
  }
  .hero__match-sub {
    margin: 0.1rem 0 0;
    font-size: 0.85rem;
    color: var(--color-ink-faint);
  }
  .hero__match-kategorie {
    margin-bottom: 0.8rem;
  }
  .hero__match-rating {
    margin: 0 0 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .hero__match-stars {
    color: var(--color-accent);
    letter-spacing: 1px;
  }
  .hero__match-count {
    color: var(--color-ink-faint);
    font-weight: 400;
  }
  .hero__match-rating--empty {
    color: var(--color-ink-faint);
    font-style: italic;
    font-weight: 400;
  }
  .hero__match-location {
    margin: 0 0 0.9rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .hero__match-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
  }
  .hero__match-tags .tag {
    font-size: 0.72rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: var(--color-bg-sunken);
    color: var(--color-ink-soft);
    border: 1px solid var(--color-line);
  }
  .hero__match-req {
    background: var(--color-bg-sunken);
    border-radius: 8px;
    padding: 0.7rem 0.9rem;
    margin-bottom: 1.1rem;
  }
  .hero__match-req-label {
    margin: 0 0 0.15rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-faint);
    font-weight: 700;
  }
  .hero__match-req p:last-child {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .hero__match-cta {
    display: block;
    text-align: center;
    width: 100%;
  }
</style>
