---
import { getRatingSummary, primaryKategorie } from '../lib/buildData';
import { CATEGORY_LABELS } from '../lib/categoryLabels';
import type { Provider } from '../lib/types';
import StarRating from './StarRating.astro';

interface Props {
  provider: Provider;
}

const { provider } = Astro.props;
const rating = getRatingSummary(provider);
const href = `/${primaryKategorie(provider)}/${provider.slug}/`;
---

<a class="provider-card card" href={href}>
  <div class="provider-card__head">
    <div class="provider-card__kategorien">
      {provider.kategorien.map((k) => <span class="badge-pill">{CATEGORY_LABELS[k].singular}</span>)}
    </div>
    <StarRating average={rating.average} count={rating.count} size="sm" />
  </div>

  <h3 class="provider-card__name">{provider.name}</h3>
  {provider.tagline && <p class="provider-card__tagline">{provider.tagline}</p>}

  <dl class="provider-card__meta">
    <div>
      <dt>Standort</dt>
      <dd>{provider.ort?.name ?? 'Bundesweit'}{provider.bundesweit_remote && provider.ort ? ' · Remote möglich' : ''}</dd>
    </div>
    {
      provider.preismodell && (
        <div>
          <dt>Preis</dt>
          <dd>{provider.preismodell}</dd>
        </div>
      )
    }
  </dl>

  {
    provider.spezialisierungen.length > 0 && (
      <div class="provider-card__tags">
        {provider.spezialisierungen.slice(0, 4).map((s) => (
          <span class="tag">{s.name}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  .provider-card {
    display: block;
    padding: 1.3rem 1.4rem;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .provider-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -14px rgba(28, 43, 34, 0.28);
  }
  .provider-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.7rem;
  }
  .provider-card__kategorien {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .provider-card__name {
    margin: 0 0 0.3rem;
    font-size: 1.15rem;
  }
  .provider-card__tagline {
    margin: 0 0 0.9rem;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .provider-card__meta {
    display: flex;
    gap: 1.5rem;
    margin: 0 0 0.9rem;
    flex-wrap: wrap;
  }
  .provider-card__meta dt {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-faint);
    margin-bottom: 0.15rem;
  }
  .provider-card__meta dd {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .provider-card__tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-bg-sunken);
    color: var(--color-ink-soft);
    border: 1px solid var(--color-line);
  }
</style>
