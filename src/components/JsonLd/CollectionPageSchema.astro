---
// CollectionPage + ItemList is Google's recommended pattern for listing/directory
// pages (as opposed to Product schema, which doesn't fit service providers).
interface ListItem {
  name: string;
  url: string;
}

interface Props {
  name: string;
  description: string;
  url: string;
  items: ListItem[];
}

const { name, description, url, items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name,
  description,
  url,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      url: item.url,
    })),
  },
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
